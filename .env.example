# Copy to .env and fill in. Loaded automatically by cmd/vane (godotenv);
# absence of .env is not an error, but the required vars below must be set
# some other way if you skip this file.

# --- Required ---

DATABASE_URL=postgres://vane:vane@localhost:5432/vane?sslmode=disable
# Any value >= 32 characters works for local dev; generate a real one with
# `openssl rand -hex 32` for anything beyond your own machine.
VANE_MASTER_KEY=dev-master-key-change-me-0123456789
VANE_SESSION_SECRET=dev-session-secret-change-me-0123456789
PORT=8080
POLL_INTERVAL_SECONDS=60

# --- Optional ---

# zap log level (default: info)
LOG_LEVEL=info

# Single allowed CORS origin (default: http://localhost:5173, matches Vite dev server)
CORS_ALLOWED_ORIGIN=http://localhost:5173

# DNS target admins should point their custom domain at. Empty by default —
# "attach domain" screen shows "not configured" until set.
PUBLIC_DNS_TARGET=

# Port for the public, TLS-terminated status page listener (default: 443)
HTTPS_PORT=443

# Where CertMagic persists issued certificates (default: ./certmagic-data).
# Production: must be a persistent volume.
CERTMAGIC_STORAGE_PATH=./certmagic-data
