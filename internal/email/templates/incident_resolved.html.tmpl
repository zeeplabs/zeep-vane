<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
{{template "head_meta" .}}
<title>Incident resolved: {{.IncidentTitle}}</title>
{{template "head_style" .}}
</head>
<body style="margin:0; padding:0; background:#F1EFF7;">
<div style="display:none; font-size:1px; color:#F1EFF7; line-height:1px; max-height:0; max-width:0; opacity:0; overflow:hidden; mso-hide:all;">Resolved · {{.IncidentTitle}}{{if .TotalDuration}}, lasted {{.TotalDuration}}{{end}}.{{template "preheader_pad"}}</div>
{{template "card_open" .}}
<tr><td style="height:4px; line-height:4px; font-size:0; background:#3DD68C;">&nbsp;</td></tr>

{{template "brand_header" .}}

<tr><td style="padding:20px 40px 0 40px;" class="pad">
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:14px;"><tr><td>
    <span style="display:inline-block; padding:4px 11px; border-radius:999px; background:#E7F6EF; color:#146C4A; font-family:Arial, Helvetica, 'Segoe UI', sans-serif; font-size:11.5px; font-weight:bold;">&#9679;&nbsp; INCIDENT RESOLVED</span>
  </td></tr></table>
  <h1 style="margin:0 0 8px 0; font-family:Arial, Helvetica, 'Segoe UI', sans-serif; font-size:22px; font-weight:bold; letter-spacing:-0.01em; color:#1C1526;">{{.IncidentTitle}}</h1>
  <p style="margin:0 0 22px 0; font-family:Arial, Helvetica, 'Segoe UI', sans-serif; font-size:13px; color:#9A93A8;">{{if .ResolvedAtText}}Resolved {{.ResolvedAtText}}{{else}}Incident resolved{{end}}{{if .TenantName}} · Organization {{.TenantName}}{{end}}</p>
  {{if .ResolutionSummary}}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
    <td style="border-left:3px solid #3DD68C; background:#E7F6EF; padding:14px 18px; font-family:Arial, Helvetica, 'Segoe UI', sans-serif; font-size:13.5px; line-height:1.6; color:#1C1526; border-radius:0 8px 8px 0;">{{.ResolutionSummary}}</td>
  </tr></table>
  <div style="height:22px; line-height:22px; font-size:0;">&nbsp;</div>
  {{end}}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#F2F0FA; border-radius:12px; margin-bottom:26px;"><tr><td style="padding:20px 22px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid #ECE9F2; margin-top:2px;"><tr><td style="padding:11px 0 0 0;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td style="padding:0 0 11px 0;  font-family:Arial, Helvetica, 'Segoe UI', sans-serif; font-size:13px; color:#6E6779;">Service</td>
      <td align="right" style="padding:0 0 11px 0;  font-family:Arial, Helvetica, 'Segoe UI', sans-serif; font-size:13px; font-weight:bold; color:#1C1526;">{{if .ServiceName}}{{.ServiceName}}{{else}}—{{end}}</td>
    </tr>
    <tr>
      <td style="padding:11px 0; border-top:1px solid #ECE9F2; font-family:Arial, Helvetica, 'Segoe UI', sans-serif; font-size:13px; color:#6E6779;">Total duration</td>
      <td align="right" style="padding:11px 0; border-top:1px solid #ECE9F2; font-family:Arial, Helvetica, 'Segoe UI', sans-serif; font-size:13px; font-weight:bold; color:#1C1526;">{{if .TotalDuration}}{{.TotalDuration}}{{else}}—{{end}}</td>
    </tr>
    <tr>
      <td style="padding:11px 0; border-top:1px solid #ECE9F2; font-family:Arial, Helvetica, 'Segoe UI', sans-serif; font-size:13px; color:#6E6779;">Opened</td>
      <td align="right" style="padding:11px 0; border-top:1px solid #ECE9F2; font-family:Arial, Helvetica, 'Segoe UI', sans-serif; font-size:13px; font-weight:bold; color:#1C1526;">{{if .OpenedAtRow}}{{.OpenedAtRow}}{{else}}—{{end}}</td>
    </tr>
    <tr>
      <td style="padding:11px 0; border-top:1px solid #ECE9F2; font-family:Arial, Helvetica, 'Segoe UI', sans-serif; font-size:13px; color:#6E6779;">Resolved</td>
      <td align="right" style="padding:11px 0; border-top:1px solid #ECE9F2; font-family:Arial, Helvetica, 'Segoe UI', sans-serif; font-size:13px; font-weight:bold; color:#1C1526;">{{if .ResolvedAtRow}}{{.ResolvedAtRow}}{{else}}—{{end}}</td>
    </tr></table></td></tr></table>
  </td></tr></table>
  {{if .DashboardURL}}
<table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
  <td bgcolor="#5A46C7" style="border-radius:9px;">
    <a href="{{.DashboardURL}}" target="_blank" style="display:block; padding:13px 28px; font-family:Arial, Helvetica, 'Segoe UI', sans-serif; font-size:14px; font-weight:bold; color:#FFFFFF; text-decoration:none; border-radius:9px;">View incident report</a>
  </td>
</tr></table>
  {{end}}<p style="margin:22px 0 0 0; font-family:Arial, Helvetica, 'Segoe UI', sans-serif; font-size:12.5px; line-height:1.6; color:#9A93A8;">You're receiving this alert because you're an admin{{if .TenantName}} of {{.TenantName}}{{end}} subscribed to incident alerts.</p>
</td></tr>
{{template "footer_open" .}}
{{template "footer_close" .}}
