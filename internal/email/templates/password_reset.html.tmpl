<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
{{template "head_meta" .}}
<title>Reset your password · Vane</title>
{{template "head_style" .}}
</head>
<body style="margin:0; padding:0; background:#F1EFF7;">
<div style="display:none; font-size:1px; color:#F1EFF7; line-height:1px; max-height:0; max-width:0; opacity:0; overflow:hidden; mso-hide:all;">Reset the password for your Vane account.{{if .ExpiresIn}} The link expires in {{.ExpiresIn}}.{{end}}{{template "preheader_pad"}}</div>
{{template "card_open" .}}
<tr><td style="height:4px; line-height:4px; font-size:0; background:#5A46C7;">&nbsp;</td></tr>

{{template "brand_header" .}}

<tr><td style="padding:20px 40px 0 40px;" class="pad">
  <div style="font-family:Arial, Helvetica, 'Segoe UI', sans-serif; font-size:11px; font-weight:bold; letter-spacing:0.09em; text-transform:uppercase; color:#5A46C7; margin:0 0 14px 0;">ACCOUNT SECURITY</div>
  <h1 style="margin:0 0 14px 0; font-family:Arial, Helvetica, 'Segoe UI', sans-serif; font-size:24px; font-weight:bold; letter-spacing:-0.01em; color:#1C1526;">Reset your password</h1>
  <p style="margin:0 0 26px 0; font-family:Arial, Helvetica, 'Segoe UI', sans-serif; font-size:14.5px; line-height:1.65; color:#6E6779;">We received a request to reset the password for the account associated with {{if .UserEmail}}<strong style="color:#1C1526;">{{.UserEmail}}</strong>{{else}}this email address{{end}}. Click the button below to choose a new password.</p>

<table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
  <td bgcolor="#5A46C7" style="border-radius:9px;">
    <a href="{{.ResetURL}}" target="_blank" style="display:block; padding:13px 28px; font-family:Arial, Helvetica, 'Segoe UI', sans-serif; font-size:14px; font-weight:bold; color:#FFFFFF; text-decoration:none; border-radius:9px;">Reset password</a>
  </td>
</tr></table>
  {{if .ExpiresIn}}<p style="margin:20px 0 22px 0; font-family:Arial, Helvetica, 'Segoe UI', sans-serif; font-size:12.5px; line-height:1.6; color:#9A93A8;">For security reasons, this link expires in {{.ExpiresIn}}.</p>{{else}}<div style="height:22px; line-height:22px; font-size:0;">&nbsp;</div>{{end}}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#F2F0FA; border-radius:10px;"><tr><td style="padding:14px 18px; font-family:Arial, Helvetica, 'Segoe UI', sans-serif; font-size:13px; line-height:1.6; color:#6E6779;">If you didn't request this change, ignore this email — your current password will keep working as usual.</td></tr></table>
  <p style="margin:20px 0 8px 0; font-family:Arial, Helvetica, 'Segoe UI', sans-serif; font-size:12px; line-height:1.6; color:#9A93A8;">Or copy and paste this link into your browser:<br><a href="{{.ResetURL}}" style="color:#5A46C7; word-break:break-all;">{{.ResetURL}}</a></p>
</td></tr>
{{template "footer_open" .}}
{{template "footer_close" .}}
